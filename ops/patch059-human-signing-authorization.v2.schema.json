{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SATCO PATCH-059 Human signing authorization v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "purpose", "operating_mode", "policy_sha256", "authority", "dispatcher", "release_id", "source_sha", "candidate_run_id", "candidate_run_attempt", "candidate_identity_sha256", "artifact_digests", "security_decision_commit", "security_decision_sha256", "workflow_run_id", "workflow_run_attempt", "workflow_run_url", "workflow_actor", "workflow_triggering_actor", "workflow_run_evidence_sha256", "job", "environment", "environment_policy_sha256", "environment_evidence_sha256", "branch_policies_evidence_sha256", "approval_history_evidence_sha256", "approval_comment", "approval_submitted_at", "approval_event_sha256", "created_at"],
  "properties": {
    "schema": {"const": "satco.patch059-human-signing-authorization/v2"},
    "decision": {"const": "approved"},
    "purpose": {"const": "protected-signing-authorization"},
    "operating_mode": {"const": "single-human-authority"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "authority": {"$ref": "#/$defs/human"},
    "dispatcher": {"$ref": "#/$defs/dispatcher"},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_sha": {"$ref": "#/$defs/source"},
    "candidate_run_id": {"type": "integer", "minimum": 1},
    "candidate_run_attempt": {"type": "integer", "minimum": 1},
    "candidate_identity_sha256": {"$ref": "#/$defs/digest"},
    "artifact_digests": {"$ref": "#/$defs/artifacts"},
    "security_decision_commit": {"$ref": "#/$defs/source"},
    "security_decision_sha256": {"$ref": "#/$defs/digest"},
    "workflow_run_id": {"type": "integer", "minimum": 1},
    "workflow_run_attempt": {"const": 1},
    "workflow_run_url": {"type": "string", "format": "uri"},
    "workflow_actor": {"$ref": "#/$defs/actor"},
    "workflow_triggering_actor": {"$ref": "#/$defs/actor"},
    "workflow_run_evidence_sha256": {"$ref": "#/$defs/digest"},
    "job": {"const": "sign-candidate"},
    "environment": {"const": "patch058-protected-release"},
    "environment_policy_sha256": {"$ref": "#/$defs/digest"},
    "environment_evidence_sha256": {"$ref": "#/$defs/digest"},
    "branch_policies_evidence_sha256": {"$ref": "#/$defs/digest"},
    "approval_history_evidence_sha256": {"$ref": "#/$defs/digest"},
    "approval_comment": {"type": "string", "minLength": 1, "maxLength": 1000},
    "approval_submitted_at": {"type": "string", "format": "date-time"},
    "approval_event_sha256": {"$ref": "#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "human": {"type": "object", "additionalProperties": false, "required": ["login", "id", "type"], "properties": {"login": {"const": "samiphone651-sys"}, "id": {"const": 301386823}, "type": {"const": "User"}}},
    "actor": {"type": "object", "additionalProperties": false, "required": ["login", "id", "type"], "properties": {"login": {"type": "string", "minLength": 1}, "id": {"type": "integer", "minimum": 1}, "type": {"const": "Bot"}}},
    "dispatcher": {"type": "object", "additionalProperties": false, "required": ["login", "id", "type", "app_id", "installation_id"], "properties": {"login": {"type": "string", "minLength": 1}, "id": {"type": "integer", "minimum": 1}, "type": {"const": "Bot"}, "app_id": {"type": "integer", "minimum": 1}, "installation_id": {"type": "integer", "minimum": 1}}, "not": {"anyOf": [{"properties": {"login": {"const": "samiphone651-sys"}}, "required": ["login"]}, {"properties": {"id": {"const": 301386823}}, "required": ["id"]}]}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["backend", "frontend", "migrations"], "properties": {"backend": {"$ref": "#/$defs/digest"}, "frontend": {"$ref": "#/$defs/digest"}, "migrations": {"$ref": "#/$defs/digest"}}}
  }
}
