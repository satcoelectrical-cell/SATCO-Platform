FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d AS runtime

WORKDIR /app
ARG SOURCE_DATE_EPOCH
RUN apt-get update && \
    apt-get install --only-upgrade -y --no-install-recommends libpcre2-8-0 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system satco && useradd --system --gid satco --home-dir /nonexistent satco && \
    touch -d "@$SOURCE_DATE_EPOCH" \
      /etc /etc/passwd /etc/passwd- /etc/group /etc/group- \
      /etc/shadow /etc/shadow- /etc/gshadow /etc/gshadow-

COPY requirements.production.lock /app/requirements.production.lock
RUN pip install --no-cache-dir --require-hashes \
    -r /app/requirements.production.lock

COPY app /app/app
COPY alembic.ini /app/alembic.ini
COPY migrations /app/migrations

USER satco:satco
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
